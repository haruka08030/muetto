# Supabase 接続情報。
# このファイルをコピーして app/.env を作る:
#   cp app/.env.example app/.env
#
# .env はアセットとしてアプリバンドルに同梱される。
# 置いてよいのは公開鍵のみ。service_role key は RLS を迂回するため絶対に入れない。
#
# --dart-define で渡した値が .env より優先される（CI・リリースビルド向け）。

SUPABASE_URL=https://your-project.supabase.co

# 新形式の sb_publishable_... と、従来の anon key のどちらでもよい。
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
